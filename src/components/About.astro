---
import type { About } from '../types';

const { bio } = (await import('../data/about.json')).default as About;
---

<section id="about">
  <div class="about-inner">
    <h2 class="section-title">About me</h2>
    <div class="about-content">
      <div class="about-text">
        {bio.map(paragraph => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  section {
    border-top: 1px solid var(--color-border);
  }

  .about-inner {
    max-width: 64rem;
    margin: 0 auto;
    padding: 6rem 1.5rem;
  }

  .section-title {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 2rem;
  }

  .about-text {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .about-text p {
    color: #a1a1aa;
    line-height: 1.75;
    margin: 0;
  }

  .about-text strong {
    color: #fafafa;
    font-weight: 500;
  }
</style>