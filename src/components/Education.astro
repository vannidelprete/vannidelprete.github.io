---
import type { Education, Certification } from '../types';

const education = (await import('../data/education.json')).default as Education[];
const certifications = (await import('../data/certifications.json')).default as Certification[];
---

<section id="education">
  <div class="education-inner">
    <h2 class="section-title">Education</h2>

    <div class="timeline">
      {education.map(edu => (
        <div class="timeline-item">
          <div class="timeline-dot" />
          <div class="timeline-content">
            <div class="timeline-header">
              <div>
                <h3 class="institution">{edu.institution}</h3>
                <p class="degree">{edu.degree}</p>
                {edu.thesis && <p class="thesis">Thesis: "{edu.thesis}"</p>}
              </div>
              <div class="meta">
                <span class="period">{edu.period}</span>
                {edu.grade && <span class="grade">{edu.grade}</span>}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <h2 class="section-title certifications-title">Certifications</h2>

    <div class="certifications">
      {certifications.map(cert => (
        <a href={cert.url} target="_blank" rel="noopener noreferrer" class="cert-card">
          <div class="cert-header">
            <span class="cert-platform">{cert.platform}</span>
            <span class="cert-date">{cert.date}</span>
          </div>
          <h3 class="cert-title">{cert.title}</h3>
          <p class="cert-issuer">{cert.issuer}</p>
          <ul class="cert-courses">
            {cert.courses.map(c => <li>{c}</li>)}
          </ul>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  section {
    border-top: 1px solid var(--color-border);
  }

  .education-inner {
    max-width: 64rem;
    margin: 0 auto;
    padding: 6rem 1.5rem;
  }

  .section-title {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 2.5rem;
  }

  .certifications-title {
    margin-top: 4rem;
  }

  .timeline {
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--color-border);
    padding-left: 1.5rem;
    margin-left: 0.5rem;
  }

  .timeline-item {
    position: relative;
    padding-bottom: 2.5rem;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-dot {
    position: absolute;
    left: -1.875rem;
    top: 0.3rem;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background-color: var(--color-accent);
    border: 2px solid var(--color-background);
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .institution {
    font-size: 1rem;
    font-weight: 600;
    color: #fafafa;
    margin: 0;
  }

  .degree {
    font-size: 0.875rem;
    color: var(--color-accent);
    margin: 0.2rem 0 0;
  }

  .thesis {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin: 0.4rem 0 0;
    font-style: italic;
  }

  .meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
  }

  .period {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
    white-space: nowrap;
  }

  .grade {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
    font-weight: 600;
  }

  .certifications {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cert-card {
    display: block;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.25rem 1.5rem;
    text-decoration: none;
    transition: border-color 0.2s;
  }

  .cert-card:hover {
    border-color: var(--color-accent);
  }

  .cert-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .cert-platform {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .cert-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .cert-title {
    font-size: 1rem;
    font-weight: 600;
    color: #fafafa;
    margin: 0 0 0.25rem;
  }

  .cert-issuer {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin: 0 0 0.75rem;
  }

  .cert-courses {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .cert-courses li {
    font-size: 0.8rem;
    color: #52525b;
    padding-left: 0.75rem;
    position: relative;
  }

  .cert-courses li::before {
    content: '›';
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }
</style>